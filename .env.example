# Copy to .env and fill in. Never commit .env.

# Primitive dashboard: API keys
PRIMITIVE_API_KEY=
# Primitive dashboard: Webhook Endpoints -> Webhook Signing Secret. Paste as shown; don't base64-decode it.
PRIMITIVE_WEBHOOK_SECRET=
# Your managed subdomain, without any address part, e.g. brave-otter.primitive.email
PRIMITIVE_DOMAIN=

# Anthropic API key (used from build step 2)
ANTHROPIC_API_KEY=

# 1 = log replies instead of sending them
DRY_RUN=0
PORT=3000
