# Copy to .env and fill in. Never commit .env.

# Primitive dashboard: API keys. Needed to send replies; with DRY_RUN=1 the server runs without it.
PRIMITIVE_API_KEY=
# Primitive dashboard: Webhook Endpoints -> Webhook Signing Secret. Paste as shown; don't base64-decode it.
PRIMITIVE_WEBHOOK_SECRET=

# Model keys: Claude is used when ANTHROPIC_API_KEY is set, otherwise Gemini.
# With neither, ask@ routes by keywords and offices can't write answers.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Vertex AI on Google Cloud, tried when the Gemini API key's models are busy or rate-limited.
# Put the service-account key file in secrets/ (gitignored).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./secrets/vertex-key.json
# Optional Vertex model overrides, comma-separated and tried in order
VERTEX_MODEL=gemini-2.5-flash-lite,gemini-2.5-flash
VERTEX_FAST_MODEL=gemini-2.5-flash-lite
# key (default) = Gemini API key first, Vertex when it fails; vertex = Vertex first
GEMINI_PREFER=key
# Optional Gemini model overrides, comma-separated and tried in order
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-flash-latest
GEMINI_FAST_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite
# Comma-separated addresses of human counselors who approve escalations
STAFF_ADDRESSES=

# Dashboard link token: open http://localhost:3000/?token=<this>. Leave empty for a random one per start.
DASHBOARD_TOKEN=

# 1 = log replies instead of sending them
DRY_RUN=0
PORT=3000
